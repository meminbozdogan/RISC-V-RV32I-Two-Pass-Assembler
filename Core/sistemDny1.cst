// Saat Sinyali (Pin 52 - Genelde Bank 0'dadır, 3.3V kalabilir)
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Reset Butonu (S1 Butonu - Pin 4, Bank 3)
IO_LOC "reset_btn" 4;
IO_PORT "reset_btn" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// LED'ler (Pin 10, 11, 13, 14, 15, 16 - Hepsi Bank 3)
IO_LOC "leds[0]" 10;
IO_LOC "leds[1]" 11;
IO_LOC "leds[2]" 13;
IO_LOC "leds[3]" 14;
IO_LOC "leds[4]" 15;
IO_LOC "leds[5]" 16;

// LVCMOS33 yerine LVCMOS18 kullanarak voltaj çakışmasını giderdik
IO_PORT "leds[0]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;
IO_PORT "leds[1]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;
IO_PORT "leds[2]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;
IO_PORT "leds[3]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;
IO_PORT "leds[4]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;
IO_PORT "leds[5]" IO_TYPE=LVCMOS18 DRIVE=8 PULL_MODE=UP;